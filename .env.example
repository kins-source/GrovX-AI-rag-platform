# Select one: ollama, openai, gemini, grok, nvidia
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Optional comma-separated model choices shown in the NVIDIA settings menu.
NVIDIA_MODELS=nvidia/llama-3.1-nemotron-70b-instruct,nvidia/llama-3.1-nemotron-51b-instruct,nvidia/llama-3.1-nemotron-ultra-253b-v1,nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4.1-flash

# API authentication
API_KEY=default-dev-key
BACKEND_URL=http://localhost:8000
